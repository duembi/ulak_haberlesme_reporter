# ── Auth & Multi-Tenant (zorunlu prod ortamında) ─────────────────────────────
# Üretim için: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_in_production_min_32_chars!!
JWT_EXPIRE_MINUTES=10080

# API key şifreleme (boşsa otomatik .encryption_key dosyasına üretilir)
# Üretim için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── İsteğe bağlı: çıktı dizinleri ───────────────────────────────────────────
REPORT_OUTPUT_DIR=reports
LOG_DIR=logs

# ── AI backend seçimi ────────────────────────────────────────────────────────
# AI_BACKEND: 'gemini' (varsayılan) | 'claude'
AI_BACKEND=gemini

# Gemini API — https://aistudio.google.com/app/apikey adresinden ücretsiz alın
GEMINI_API_KEY=your_gemini_api_key_here
# Kullanılabilir modeller: gemini-2.5-flash | gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# ── İsteğe bağlı: Claude CLI zaman aşımı ve model ───────────────────────────
# Claude Code CLI kurulu ve kimlik doğrulaması yapılmış olmalı (AI_BACKEND=claude ise)
CLAUDE_TIMEOUT=300
# Kullanılabilir modeller: claude-haiku-4-5-20251001 | claude-sonnet-4-6 | claude-opus-4-7
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── İsteğe bağlı: Brandfetch marka rengi API ─────────────────────────────────
# Ücretsiz kayıt: https://developers.brandfetch.com/register — 500K istek/ay
# Tanımlı değilse Brandfetch atlanır, yerel DB + LLM kullanılır
BRANDFETCH_API_KEY=your_brandfetch_api_key_here

# ── İsteğe bağlı: Resend e-posta bildirimleri ────────────────────────────────
# Ücretsiz kayıt: https://resend.com — 3.000 mail/ay, kredi kartı gerekmez
# Tanımlı değilse e-posta gönderimi sessizce atlanır, pipeline devam eder
RESEND_API_KEY=re_your_api_key_here
# Test: onboarding@resend.dev  |  Prod: Ulak Haberleşme Rapor <rapor@yourdomain.com>
RESEND_FROM=Ulak Haberleşme Rapor <onboarding@resend.dev>
# Birden fazla alıcı virgülle ayrılır
EMAIL_TO=manager@example.com,other@example.com
